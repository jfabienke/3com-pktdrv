; codegen.inc -- NASM equates for the JIT fragment composer (docs/02).
; Mirrors the former C codegen.h. Shared by start.asm and the generated frags_asm.inc.

; ---- logical hot-path fragment ids (selection keys; order matches docs) ----
FRAG_ISR_ENTRY      equ 0
FRAG_ISR_EOI        equ 1
FRAG_RX_PIO         equ 2
FRAG_TX_PIO         equ 3
FRAG_RX_RING        equ 4
FRAG_TX_RING        equ 5
FRAG_RX_COPYBREAK   equ 6
FRAG_WIN_SELECT     equ 7
FRAG_CACHE_FLUSH    equ 8
FRAG_API_DISPATCH   equ 9
FRAG__COUNT         equ 10

; ---- CPU class (ordered: a fragment with cpu_min=X is emittable iff class >= X) ----
CPU_8088            equ 0
CPU_80286           equ 1
CPU_80386           equ 2
CPU_80486           equ 3       ; 486 without CPUID
CPU_CPUID           equ 4       ; CPUID present (family/model via CPUID -- future lift)
CPU_PENTIUM         equ 5       ; reserved: set by the CPUID-parsing lift
CPU_P6              equ 6

; ---- NIC generation (g_nic_gen; mirrors hardware.h nic_type_t ladder) ----
; 0/1 are the original ISA pair -- existing `cmp 0`/`cmp 1` gating is unchanged.
; The Window-1 +0x10 relocation applies to every generation >= 1 (Corkscrew on).
NIC_GEN_TOMAHAWK    equ 0       ; 3C509/B  ISA PIO (the floor)
NIC_GEN_CORKSCREW   equ 1       ; 3C515    ISA + bus-master
NIC_GEN_VORTEX      equ 2       ; 3C59x    PCI, PIO datapath
NIC_GEN_BOOMERANG   equ 3       ; 3C90x    PCI, descriptor-list DMA
NIC_GEN_CYCLONE     equ 4       ; 3C905B/C PCI, + HW checksum

; ---- immediate patch kinds ----
PATCH_IMM8          equ 0
PATCH_IMM16         equ 1

; ---- fragment table entry layout (g_frags[], generated by mkfrag.py) ----
;   +0 db id
;   +1 db cpu_min
;   +2 db n_patches
;   +3 db (reserved)
;   +4 dw len
;   +6 dw bytes_ptr   (offset in DGROUP)
;   +8 dw patches_ptr (offset in DGROUP, 0 if none)
FRAG_ENTRY_SIZE     equ 10

; ---- patch table entry layout (3 bytes) ----
;   +0 dw offset (within the fragment's bytes)
;   +2 db kind   (PATCH_IMM8 / PATCH_IMM16)
PATCH_ENTRY_SIZE    equ 3

; ---- receiver handle table (access_type) ----
;   entry: +0 dw recv_off, +2 dw recv_seg (0 = free slot), +4 dw type (0 = match all)
; off,seg ordered first so `call far [slot]` works. The returned handle IS the slot offset.
MAX_HANDLES         equ 4
HANDLE_SIZE         equ 6
